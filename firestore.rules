rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsQuiz(quizId) {
      return signedIn()
        && get(/databases/$(database)/documents/quizzes/$(quizId)).data.userId
          == request.auth.uid;
    }

    match /quizzes/{quizId} {
      allow read: if signedIn()
        && (resource == null || resource.data.published == true
          || resource.data.userId == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid;
      allow update, delete: if signedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid;

      match /questions/{questionId} {
        allow read: if signedIn()
          && (get(/databases/$(database)/documents/quizzes/$(quizId)).data.published == true
            || ownsQuiz(quizId));
        allow create, update, delete: if ownsQuiz(quizId);
      }

      match /studentAttempts/{studentId} {
        allow read: if ownsQuiz(quizId) || (signedIn() && request.auth.uid == studentId);
        allow create, update: if signedIn() && request.auth.uid == studentId;
        allow delete: if ownsQuiz(quizId) || (signedIn() && request.auth.uid == studentId);
      }
    }

    match /students/{studentId}/enrolledQuizzes/{quizId} {
      allow read, create, update, delete: if signedIn() && request.auth.uid == studentId;
    }
  }
}
